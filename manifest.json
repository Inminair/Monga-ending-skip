{
  "manifest_version": 3,
  "name": "먼가... 엔딩 스킵",
  "version": "1.1.0",
  "description": "유튜브 재생목록에서 본편이 끝나면 엔딩송을 건너뛰고 바로 다음 화로 넘어갑니다. 제목으로 화를 찾아 바로 이동할 수도 있어요.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js", "playlist.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "먼가... 엔딩 스킵",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
